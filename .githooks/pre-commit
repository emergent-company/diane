#!/bin/sh
# Pre-commit hook: run go vet + unit tests before allowing a commit.
# Skips if GIT_SKIP_TESTS is set (e.g. GIT_SKIP_TESTS=1 git commit ...)
#
# Installed via: git config core.hooksPath .githooks

set -e

if [ -n "$GIT_SKIP_TESTS" ]; then
    echo "🔶 SKIP_TESTS set — skipping checks"
    exit 0
fi

# Find the server directory (where go.mod lives)
SERVER_DIR="$(cd "$(git rev-parse --show-toplevel)/server" 2>/dev/null && pwd)"
if [ -z "$SERVER_DIR" ] || [ ! -f "$SERVER_DIR/go.mod" ]; then
    echo "⚠️  server/go.mod not found — skipping checks"
    exit 0
fi

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)
if [ -z "$STAGED_GO_FILES" ]; then
    echo "✅ No Go files staged — skipping checks"
    exit 0
fi

cd "$SERVER_DIR"

echo "🔍 Running go vet..."
go vet ./internal/... ./cmd/... 2>&1
VET_EXIT=$?

if [ $VET_EXIT -ne 0 ]; then
    echo ""
    echo "❌ go vet FAILED — commit blocked."
    echo "   Fix the issues or bypass with: GIT_SKIP_TESTS=1 git commit ..."
    exit 1
fi

echo "🧪 Running unit tests..."
go test -count=1 ./internal/... ./cmd/... 2>&1
TEST_EXIT=$?

if [ $TEST_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Unit tests FAILED — commit blocked."
    echo "   Fix the tests or bypass with: GIT_SKIP_TESTS=1 git commit ..."
    exit 1
fi

echo ""
echo "✅ go vet + unit tests passed — committing."
exit 0
