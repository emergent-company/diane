#!/bin/bash
# Pre-commit hook: build the Swift companion app when Swift files change.
# 
# This catches compilation errors (like unicode escape issues, type mismatches)
# before they reach CI.
#
# To install hooks: make setup
#   or: git config core.hooksPath .githooks

set -euo pipefail

SWIFT_DIR="server/swift/DianeCompanion"
IOS_DIR="server/swift/DianeCompanion-iOS"

# Only run if Swift files are staged
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.swift$' || true)
STAGED_IOS=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -E '(DianeCompanion-iOS|Packages/DianeShared)' || true)
if [ -z "$STAGED_SWIFT" ]; then
    exit 0
fi

# Check for xcodegen
if ! command -v xcodegen &>/dev/null; then
    echo "⚠️  xcodegen not found — skipping Swift build check"
    echo "   Install: brew install xcodegen"
    exit 0
fi

# ── macOS companion ──────────────────────────────────────────────
# Only build macOS if non-iOS Swift files are staged
if echo "$STAGED_SWIFT" | grep -vq 'DianeCompanion-iOS' 2>/dev/null; then
    echo "🔍 Swift files staged — checking macOS companion build..."
    echo "==> Generating Xcode project..."
    (cd "$SWIFT_DIR" && xcodegen generate --quiet) 2>&1

    echo "==> Building Diane scheme (debug, no signing)..."
    xcodebuild \
        -project "$SWIFT_DIR/Diane.xcodeproj" \
        -scheme Diane \
        -configuration Debug \
        -derivedDataPath "$SWIFT_DIR/build/DerivedData" \
        CODE_SIGN_IDENTITY="" \
        CODE_SIGNING_REQUIRED=NO \
        CODE_SIGNING_ALLOWED=NO \
        SWIFT_ACTIVE_COMPILATION_CONDITIONS= \
        build \
        2>&1 | tail -20

    BUILD_EXIT=${PIPESTATUS[0]}
    if [ "$BUILD_EXIT" -ne 0 ]; then
        echo ""
        echo "❌ macOS companion build FAILED. Fix errors before committing."
        exit 1
    fi
    echo "✅ macOS companion app builds cleanly."
fi

# ── iOS companion ───────────────────────────────────────────────
if [ -n "$STAGED_IOS" ]; then
    echo "🔍 iOS files staged — checking iOS companion build..."
    echo "==> Generating iOS Xcode project..."
    (cd "$IOS_DIR" && xcodegen generate --quiet) 2>&1

    echo "==> Building iOS Diane scheme (debug, no signing)..."
    xcodebuild \
        -project "$IOS_DIR/Diane.xcodeproj" \
        -scheme Diane \
        -configuration Debug \
        -sdk iphonesimulator \
        -derivedDataPath "$IOS_DIR/build/DerivedData" \
        CODE_SIGN_IDENTITY="" \
        CODE_SIGNING_REQUIRED=NO \
        CODE_SIGNING_ALLOWED=NO \
        SWIFT_ACTIVE_COMPILATION_CONDITIONS= \
        build \
        2>&1 | tail -20

    BUILD_EXIT=${PIPESTATUS[0]}
    if [ "$BUILD_EXIT" -ne 0 ]; then
        echo ""
        echo "❌ iOS companion build FAILED. Fix errors before committing."
        exit 1
    fi
    echo "✅ iOS companion app builds cleanly."
fi
