#!/bin/bash
# Pre-commit hook: run go vet + test when Go files are staged.
# 
# This catches compilation errors and test failures before they reach CI.
# Companion apps (macOS + iOS) were extracted to separate repos in May 2026.
#
# To install hooks: make setup
#   or: git config core.hooksPath .githooks

set -euo pipefail

# Companion apps (macOS + iOS) were extracted to separate repos in May 2026.
# The main diane repo now only has Go server code + shared SPM packages.
# No macOS/iOS companion builds are needed here.
# See: diane-macos (https://github.com/emergent-company/diane-macos)
# See: diane-ios   (https://github.com/emergent-company/diane-ios)

# Only run if Go files are staged (vet + test)
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.go$' || true)
if [ -z "$STAGED_GO" ]; then
    exit 0
fi

echo "🔍 Go files staged — running vet + test..."
cd "$(git rev-parse --show-toplevel)"
go vet ./internal/... ./cmd/... 2>&1 | tail -10
VET_EXIT=${PIPESTATUS[0]}
if [ "$VET_EXIT" -ne 0 ]; then
    echo "❌ go vet FAILED. Fix issues before committing."
    exit 1
fi
echo "✅ go vet passed."
go test -count=1 ./internal/... ./cmd/... 2>&1 | tail -5
echo "✅ go test passed."

